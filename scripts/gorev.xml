<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>12in12.co otomatik içerik güncellemesi (scripts/site-guncelle.mjs): her gün 09:00-24:00 arası saatte bir ve internete bağlanınca. Orkestra kaydında yayına giren Part/Uzun videoları siteye ekler, commit + push (= Netlify yayını). Değişiklik yoksa hiçbir şey yapmaz.</Description>
    <URI>\12in12-Site-Guncelle</URI>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-10-19T09:00:00+03:00</StartBoundary>
      <Repetition>
        <Interval>PT1H</Interval>
        <Duration>PT15H</Duration>
        <StopAtDurationEnd>true</StopAtDurationEnd>
      </Repetition>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
    <EventTrigger>
      <Delay>PT2M</Delay>
      <Subscription>&lt;QueryList&gt;&lt;Query Id="0" Path="Microsoft-Windows-NetworkProfile/Operational"&gt;&lt;Select Path="Microsoft-Windows-NetworkProfile/Operational"&gt;*[System[(EventID=10000)]]&lt;/Select&gt;&lt;/Query&gt;&lt;/QueryList&gt;</Subscription>
    </EventTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>S-1-5-21-4134360833-3452667867-1008354588-1001</UserId>
      <LogonType>InteractiveToken</LogonType>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT15M</ExecutionTimeLimit>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <StartWhenAvailable>true</StartWhenAvailable>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\WINDOWS\System32\conhost.exe</Command>
      <Arguments>--headless "C:\Program Files\nodejs\node.exe" scripts\site-guncelle.mjs</Arguments>
      <WorkingDirectory>C:\Users\Serhat\Desktop\12in12\Projeler\12in12-site</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
